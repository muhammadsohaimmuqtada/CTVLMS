CTVLMS_DB_ROOT_PASSWORD=replace-with-a-strong-root-password
CTVLMS_DB_NAME=ctvlms
CTVLMS_DB_USER=ctvlms_app
CTVLMS_DB_PASSWORD=replace-with-a-strong-app-password
CTVLMS_DB_HOST=127.0.0.1
CTVLMS_DB_PORT=3306
CTVLMS_APP_URL=http://127.0.0.1:8000

# Vulnerability intelligence cadence
NVD_SYNC_HOURS=6
CTVLMS_PACKAGE_ADVISORY_SYNC_HOURS=24
CTVLMS_ADVISORY_MIN_RECORDS=1000
CTVLMS_ADVISORY_MIN_RATIO=0.50

# Continuous-cycle child safety bounds (seconds)
CTVLMS_PACKAGE_ADVISORY_TIMEOUT_SECONDS=900
CTVLMS_LOCAL_INVENTORY_TIMEOUT_SECONDS=300
CTVLMS_SSH_INVENTORY_TIMEOUT_SECONDS=600
CTVLMS_SCAN_TIMEOUT_SECONDS=900
CTVLMS_VERIFICATION_TIMEOUT_SECONDS=600
CTVLMS_PATCH_WORKER_TIMEOUT_SECONDS=3600

# Remediation remains opt-in. Per-asset SSH key/known-hosts variables are
# referenced by database policy and should be supplied by the process secret store.
CTVLMS_EXECUTE_PATCHES=0
CTVLMS_MAX_PATCHES_PER_CYCLE=5
CTVLMS_PATCH_LEASE_SECONDS=300
