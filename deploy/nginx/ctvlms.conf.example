server {
    listen 80;
    listen [::]:80;
    server_name ctvlms.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ctvlms.example.com;

    root /opt/ctvlms;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/ctvlms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ctvlms.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 2m;

    location = /healthz {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /opt/ctvlms/public/healthz.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.4-fpm-ctvlms.sock;
        access_log off;
    }

    location /public/ {
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /opt/ctvlms/index.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.4-fpm-ctvlms.sock;
    }

    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
    location ~* ^/(config|database|deploy|docs|includes|tests|\.git)/ { deny all; }
    location ~* \.(sql|env|ini|log|sh|md|yml|yaml)$ { deny all; }
}
