# Copy to /etc/ctvlms/ctvlms.env and protect it with mode 600.
CTVLMS_ENV=production
CTVLMS_APP_URL=https://ctvlms.example.com

CTVLMS_DB_HOST=127.0.0.1
CTVLMS_DB_PORT=3306
CTVLMS_DB_NAME=ctvlms
CTVLMS_DB_USER=ctvlms_app
CTVLMS_DB_PASSWORD=replace-with-a-long-random-secret

# Authorised management targets only; comma-separated IPs/CIDRs.
CTVLMS_SCAN_TARGETS=192.168.1.0/24

# NVD API key is strongly recommended for frequent synchronization.
NVD_API_KEY=
NVD_SYNC_HOURS=6
CTVLMS_PACKAGE_ADVISORY_SYNC_HOURS=24
CTVLMS_ADVISORY_MIN_RECORDS=1000
CTVLMS_ADVISORY_MIN_RATIO=0.50

# Keep disabled until asset patch policies, SSH host keys, backup evidence,
# package inventory, staged rollout policy, and rollback procedures are validated.
CTVLMS_EXECUTE_PATCHES=0
CTVLMS_MAX_PATCHES_PER_CYCLE=5
CTVLMS_PATCH_LEASE_SECONDS=300

# Operational backup policy.
CTVLMS_BACKUP_DIR=/var/backups/ctvlms
CTVLMS_BACKUP_RETENTION_DAYS=14

# Per-asset SSH key variables are referenced by asset_patch_policies.sshKeyEnv.
# Example:
# CTVLMS_SSH_KEY_SERVER01=/etc/ctvlms/keys/server01_ed25519
