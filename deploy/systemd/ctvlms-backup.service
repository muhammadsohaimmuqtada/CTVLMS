[Unit]
Description=CTVLMS database backup
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=ctvlms
Group=ctvlms
EnvironmentFile=/etc/ctvlms/ctvlms.env
Environment=CTVLMS_ENV_FILE=/etc/ctvlms/ctvlms.env
Environment=CTVLMS_BACKUP_DIR=/var/backups/ctvlms
ExecStart=/opt/ctvlms/bin/backup-db.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ctvlms
